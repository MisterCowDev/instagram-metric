# ============================================================
# Copia este archivo como .env.local (y configura lo mismo en
# las Environment Variables de Vercel).
# ============================================================

# --- Base de datos PostgreSQL ---
DATABASE_URL=postgresql://usuario:clave@host:5432/basedatos
# Pon "false" solo si tu base local NO usa SSL:
PGSSL=true

# --- App de Instagram (Meta for Developers) ---
# Los obtienes en developers.facebook.com al crear la app
# y agregar el producto "Instagram API with Instagram Login".
INSTAGRAM_APP_ID=tu_instagram_app_id
INSTAGRAM_APP_SECRET=tu_instagram_app_secret
# Debe coincidir EXACTO con la URL de redirección que registres en la app:
INSTAGRAM_REDIRECT_URI=https://tu-dominio.vercel.app/api/instagram/callback

# --- Cifrado de tokens ---
# Genera la clave una vez con:  openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=clave_hex_de_64_caracteres

# --- Seguridad de los crons ---
# Genera con:  openssl rand -hex 16
CRON_SECRET=secreto_para_los_crons

# Usuario responsable por defecto al conectar una cuenta
# (en producción, tómalo de la sesión del usuario logueado).
DEFAULT_RESPONSABLE_USER_ID=1

# --- Script local: scripts/ver-metricas.ts ---
# Pega aquí el token que tenés (Instagram Login token o Facebook user token del Graph API Explorer).
# El script detecta automáticamente qué tipo de token es.
ACCESS_TOKEN=EAAxxxxxxxxxxxxxxx
